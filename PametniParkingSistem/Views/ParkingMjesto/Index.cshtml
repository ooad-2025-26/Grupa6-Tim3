@model IEnumerable<PametniParkingSistem.Models.ParkingMjesto>
@using PametniParkingSistem.Enums

@{
    ViewData["Title"] = "Parking mjesta";
}

<div class="parking-page">

    <div class="parking-header">
        <h1>Parking mjesta</h1>
        <p>Odaberite parking mjesto. Dostupnost se provjerava prema terminu rezervacije.</p>

        @if (User.IsInRole("Administrator"))
        {
            <a asp-action="Create" class="btn btn-primary mb-4">
                <i class="fa-solid fa-plus me-2"></i>
                Dodaj novo parking mjesto
            </a>
        }
    </div>

    <div class="filter-section-bg">
    <div class="parking-filter-wrapper">

        <div class="parking-filter-header">
            <div>
                <h3>Pretraži parking mjesta</h3>
                <p>Filtrirajte mjesta prema zoni, tipu, natkrivenosti, cijeni i udaljenosti.</p>
            </div>

            <div class="filter-badge">
                <i class="fa-solid fa-sliders"></i>
                Pametni filteri
            </div>
        </div>

        <form asp-action="Index" method="get">

            <div class="modern-filter-grid">

                <div class="modern-input-group">
                    <label>Zona</label>

                    <div class="input-icon">
                        <i class="fa-solid fa-location-dot"></i>

                        <select name="zonaId" class="modern-input">
                            <option value="">Sve zone</option>
                            <option value="1">Zona A</option>
                            <option value="2">Zona B</option>
                            <option value="3">Zona C</option>
                            <option value="4">VIP zona</option>
                        </select>
                    </div>
                </div>

                <div class="modern-input-group">
                    <label>Tip mjesta</label>

                    <div class="input-icon">
                        <i class="fa-solid fa-car"></i>

                        <select name="tipMjesta" class="modern-input">
                            <option value="">Svi tipovi</option>
                            <option value="Standardno">Standardno</option>
                            <option value="Invalidsko">Invalidsko</option>
                            <option value="ElektricnoVozilo">Električno vozilo</option>
                        </select>
                    </div>
                </div>

                <div class="modern-input-group">
                    <label>Natkriveno</label>

                    <div class="input-icon">
                        <i class="fa-solid fa-warehouse"></i>

                        <select name="natkriveno" class="modern-input">
                            <option value="">Sve</option>
                            <option value="true">Da</option>
                            <option value="false">Ne</option>
                        </select>
                    </div>
                </div>

                <div class="modern-input-group">
                    <label>Max udaljenost</label>

                    <div class="input-icon">
                        <i class="fa-solid fa-person-walking"></i>

                        <input name="maxUdaljenost"
                               type="number"
                               step="1"
                               class="modern-input"
                               placeholder="npr. 50" />
                    </div>
                </div>

            </div>

            <div class="filter-bottom-actions">

                <div class="price-row">

                    <div class="price-box">
                        <label>Min cijena</label>
                        <div class="input-icon">
                            <i class="fa-solid fa-money-bill-wave"></i>
                            <input name="minCijena"
                                   type="number"
                                   step="0.1"
                                   class="modern-input"
                                   placeholder="0" />
                        </div>
                    </div>

                    <div class="price-box">
                        <label>Max cijena</label>
                        <div class="input-icon">
                            <i class="fa-solid fa-money-bill-wave"></i>
                            <input name="maxCijena"
                                   type="number"
                                   step="0.1"
                                   class="modern-input"
                                   placeholder="5" />
                        </div>
                    </div>

                </div>


                <div class="filter-buttons">

                    <button type="submit" class="search-btn-modern">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        Pretraži
                    </button>

                    <a asp-action="Index" class="reset-btn-modern">
                        Resetuj filter
                    </a>

                </div>

            </div>

        </form>

    </div>
    </div>

    @foreach (var zona in Model.GroupBy(x => x.ParkingZonaId).OrderBy(x => x.Key))
    {
        string nazivZone = zona.Key switch
        {
            1 => "Zona A",
            2 => "Zona B",
            3 => "Zona C",
            4 => "VIP zona",
            _ => $"Zona {zona.Key}"
        };

        string opisZone = zona.Key switch
        {
            1 => "Najbliže ulazu",
            2 => "Standardna zona",
            3 => "Ekonomična zona",
            4 => "Premium parking mjesta",
            _ => "Parking zona"
        };

        <section class="zona-wrapper">

            <div class="zona-title">
                <h3>@nazivZone</h3>
                <span>@opisZone</span>
            </div>


            <div class="scroll-wrapper">

<button class="scroll-btn left" onclick="scrollLeftZone(this)">
    ❮
</button>

            <div class="parking-grid zone-scroll">

                    @foreach (var item in zona.OrderBy(x =>
        int.TryParse(
            new string(x.Oznaka.Where(char.IsDigit).ToArray()),
            out int broj)
            ? broj
            : int.MaxValue))
                {
                    string cardClass = "standard-card";
                    string icon = "fa-square-parking";
                    string tipText = "Standardno";

                    if (item.TipMjesta == TipMjesta.Invalidsko)
                    {
                        cardClass = "invalid-card";
                        icon = "fa-wheelchair";
                        tipText = "Invalidsko";
                    }
                    else if (item.TipMjesta == TipMjesta.ElektricnoVozilo)
                    {
                        cardClass = "ev-card";
                        icon = "fa-bolt";
                        tipText = "Električno vozilo";
                    }

                        if (item.ParkingZonaId == 4)
                        {
                            cardClass = "vip-card";
                        }

                        if (item.Status == StatusMjesta.VanFunkcije)
                        {
                            cardClass = "disabled-card";
                        }
                        else if (item.Status == StatusMjesta.Zauzeto || item.Status == StatusMjesta.Rezervisano)
                        {
                            cardClass = "reserved-card";
                        }

                        <div class="parking-card @cardClass @(ViewBag.PreporucenoMjestoId == item.Id ? "recommended-card" : "")">

                            @if (ViewBag.PreporucenoMjestoId == item.Id)
                            {
                                <div class="recommended-badge">
                                    <i class="fa-solid fa-star"></i>
                                    Preporučeno
                                </div>
                            }

                        <div class="parking-card-top">
                            <i class="fa-solid @icon"></i>
                            <span>@tipText</span>
                        </div>

                        <div class="parking-oznaka">
                            @item.Oznaka
                        </div>

                        <div class="parking-meta">
                            <span>
                                <i class="fa-solid fa-money-bill-wave me-1"></i>
                                @item.CijenaPoSatu KM/h
                            </span>

                            <span>
                                <i class="fa-solid fa-person-walking me-1"></i>
                                @item.UdaljenostOdUlaza m
                            </span>
                        </div>



                        <div class="parking-features">
                            @if (item.Natkriveno)
                            {
                                <span>Natkriveno</span>
                            }
                            else
                            {
                                <span>Otvoreno</span>
                            }

                            @if (item.Oznaka.ToUpper().Contains("VIP"))
                            {
                                <span>Premium</span>
                            }
                        </div>

                        <div class="parking-actions">

                            <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-light btn-sm">
                                Detalji
                            </a>

                            @if (User.Identity != null
                                                    && User.Identity.IsAuthenticated
                                                    && User.IsInRole("RegistrovaniKorisnik")
                                                    && item.Status != StatusMjesta.VanFunkcije)
                            {
                                <a asp-controller="Rezervacija"
                                       asp-action="Create"
                                       asp-route-parkingMjestoId="@item.Id"
                                       class="btn btn-success btn-sm">
                                    Rezerviši
                                </a>
                            }

                            @if (item.Status == StatusMjesta.VanFunkcije)
                            {
                                <span class="badge bg-danger">
                                    Van funkcije
                                </span>
                            }

                                @if (item.Status == StatusMjesta.VanFunkcije)
                                {
                                    <div class="parking-out-service">
                                        <i class="fas fa-exclamation-circle me-2"></i>
                                        Ovo parking mjesto trenutno nije u funkciji.
                                    </div>
                                }
                                else if (item.Status == StatusMjesta.Zauzeto || item.Status == StatusMjesta.Rezervisano)
                                {
                                    <div class="parking-out-service">
                                        <i class="fas fa-lock me-2"></i>
                                        Parking mjesto je trajno rezervisano za posebne korisnike.
                                    </div>
                                }

                        </div>

                        @if (User.IsInRole("Administrator") || User.IsInRole("Operater"))
                        {
                            <div class="admin-actions">
                                <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">
                                    <i class="fa-solid fa-pen-to-square me-1"></i>
                                    Uredi status
                                </a>

                                @if (User.IsInRole("Administrator"))
                                {
                                    <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-danger btn-sm">
                                        <i class="fa-solid fa-trash me-1"></i>
                                        Obriši
                                    </a>
                                }
                            </div>
                        }

                    </div>
                }

            </div>

                <button class="scroll-btn right" onclick="scrollRightZone(this)">
                    ❯
                </button>

            </div>

        </section>
    }

</div>

<script>
    function updateScrollButtons(wrapper) {
        const container = wrapper.querySelector('.zone-scroll');
        const leftBtn = wrapper.querySelector('.scroll-btn.left');
        const rightBtn = wrapper.querySelector('.scroll-btn.right');

        if (container.scrollLeft > 20) {
            leftBtn.style.display = 'block';
        } else {
            leftBtn.style.display = 'none';
        }

        if (container.scrollLeft + container.clientWidth >= container.scrollWidth - 20) {
            rightBtn.style.display = 'none';
        } else {
            rightBtn.style.display = 'block';
        }
    }

    function scrollLeftZone(button) {
        const wrapper = button.parentElement;
        const container = wrapper.querySelector('.zone-scroll');

        container.scrollBy({
            left: -700,
            behavior: 'smooth'
        });

        setTimeout(() => updateScrollButtons(wrapper), 400);
    }

    function scrollRightZone(button) {
        const wrapper = button.parentElement;
        const container = wrapper.querySelector('.zone-scroll');

        container.scrollBy({
            left: 700,
            behavior: 'smooth'
        });

        setTimeout(() => updateScrollButtons(wrapper), 400);
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.scroll-wrapper').forEach(wrapper => {
            const container = wrapper.querySelector('.zone-scroll');

            updateScrollButtons(wrapper);

            container.addEventListener('scroll', function () {
                updateScrollButtons(wrapper);
            });
        });
    });
</script>