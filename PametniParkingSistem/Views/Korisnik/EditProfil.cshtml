@model PametniParkingSistem.Models.Korisnik

@{
    ViewData["Title"] = "Uredi profil";
}

<div class="page-header mb-4">
    <h1>Uredi profil</h1>
    <p class="text-muted">Ažurirajte vaše korisničke podatke.</p>
</div>

<div class="card p-4 shadow-sm">
    <form asp-action="EditProfil" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Ime" class="form-label"></label>
                <input asp-for="Ime" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Prezime" class="form-label"></label>
                <input asp-for="Prezime" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
            </div>

            <div class="col-md-6 mb-4">
                <label asp-for="PhoneNumber" class="form-label">Telefon</label>
                <input asp-for="PhoneNumber" class="form-control" />
            </div>
        </div>

        <div class="d-flex flex-wrap gap-3">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk me-2"></i>
                Sačuvaj izmjene
            </button>

            <a asp-action="Profil" class="btn btn-secondary">
                Nazad
            </a>
        </div>

    </form>
</div>