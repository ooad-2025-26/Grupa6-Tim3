@model PametniParkingSistem.Models.Rezervacija

@{
    ViewData["Title"] = "Uredi rezervaciju";

    var trajanje = Model.VrijemeKraja - Model.VrijemePocetka;
}

<div class="page-header mb-4">
    <h1>Uredi rezervaciju</h1>
    <p class="text-muted">
        Izmijenite termin i kontakt podatke rezervacije.
    </p>
</div>

<div class="row g-4">

    <div class="col-lg-5">

        <div class="reservation-edit-summary">

            <div class="reservation-edit-icon">
                <i class="fa-solid fa-pen-to-square"></i>
            </div>

            <h2>
                @if (Model.ParkingMjesto != null)
                {
                    @Model.ParkingMjesto.Oznaka
                }
                else
                {
                    @($"Mjesto #{Model.ParkingMjestoId}")
                }
            </h2>

            <p>Rezervacija #@Model.Id</p>

            <div class="edit-summary-list">

                <div>
                    <span>Trenutno trajanje</span>
                    <strong>@Math.Ceiling(trajanje.TotalHours) h</strong>
                </div>

                <div>
                    <span>Status rezervacije</span>
                    <strong>@Model.StatusRezervacije</strong>
                </div>

                <div>
                    <span>Ukupna cijena</span>
                    <strong>@Model.UkupnaCijena.ToString("0.00") KM</strong>
                </div>

            </div>

            <div class="edit-summary-note">
                <i class="fa-solid fa-circle-info me-2"></i>
                Ako nova rezervacija ima veću cijenu, sistem će automatski tražiti doplatu.
            </div>

        </div>

    </div>

    <div class="col-lg-7">

        <div class="card p-4 shadow-sm">

            <div class="reservation-info-box mb-4">
                <i class="fa-solid fa-clock-rotate-left me-2"></i>
                Dostupnost parking mjesta provjerava se automatski za novi termin.
            </div>

            <form asp-action="Edit" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="DatumKreiranja" />
                <input type="hidden" asp-for="KorisnikId" />
                <input type="hidden" asp-for="ParkingMjestoId" />
                <input type="hidden" asp-for="StatusRezervacije" />
                <input type="hidden" asp-for="UkupnaCijena" />

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="VrijemePocetka" class="form-label">
                            Vrijeme početka <span class="text-danger">*</span>
                        </label>

                        <input asp-for="VrijemePocetka"
                               class="form-control"
                               type="datetime-local" />

                        <span asp-validation-for="VrijemePocetka" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="VrijemeKraja" class="form-label">
                            Vrijeme kraja <span class="text-danger">*</span>
                        </label>

                        <input asp-for="VrijemeKraja"
                               class="form-control"
                               type="datetime-local" />

                        <span asp-validation-for="VrijemeKraja" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="RegistracijskeTablice" class="form-label">
                            Registracijske tablice <span class="text-danger">*</span>
                        </label>

                        <input asp-for="RegistracijskeTablice"
                               class="form-control"
                               placeholder="npr. A12-K-345" />

                        <span asp-validation-for="RegistracijskeTablice" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="KontaktTelefon" class="form-label">
                            Kontakt telefon <span class="text-danger">*</span>
                        </label>

                        <input asp-for="KontaktTelefon"
                               class="form-control"
                               placeholder="npr. 061123456" />

                        <span asp-validation-for="KontaktTelefon" class="text-danger"></span>
                    </div>

                    <div class="col-md-12 mb-4">
                        <label asp-for="EmailZaObavijest" class="form-label">
                            Email za obavijest <span class="text-danger">*</span>
                        </label>

                        <input asp-for="EmailZaObavijest"
                               class="form-control"
                               placeholder="npr. korisnik@gmail.com" />

                        <span asp-validation-for="EmailZaObavijest" class="text-danger"></span>

                        <small class="text-muted">
                            Na ovaj email će stići potvrda izmjene rezervacije i eventualne doplate.
                        </small>
                    </div>

                </div>

                <div class="d-flex flex-wrap gap-2">

                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Sačuvaj izmjene
                    </button>

                    <a asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary">
                        Detalji rezervacije
                    </a>

                    <a asp-action="Index"
                           class="btn btn-secondary">
                        Nazad
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>