@model PametniParkingSistem.Models.Rezervacija

@{
    ViewData["Title"] = "Otkazivanje rezervacije";
}

<h1>Otkazivanje rezervacije</h1>

<div class="alert alert-warning">
    Da li ste sigurni da želite otkazati ovu rezervaciju?
</div>

<dl class="row">
    <dt class="col-sm-3">Vrijeme početka</dt>
    <dd class="col-sm-9">@Model.VrijemePocetka.ToString("dd.MM.yyyy HH:mm")</dd>

    <dt class="col-sm-3">Vrijeme kraja</dt>
    <dd class="col-sm-9">@Model.VrijemeKraja.ToString("dd.MM.yyyy HH:mm")</dd>

    <dt class="col-sm-3">Registracijske tablice</dt>
    <dd class="col-sm-9">@Model.RegistracijskeTablice</dd>

    <dt class="col-sm-3">Kontakt telefon</dt>
    <dd class="col-sm-9">@Model.KontaktTelefon</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.EmailZaObavijest</dd>

    <dt class="col-sm-3">Ukupna cijena</dt>
    <dd class="col-sm-9">@Model.UkupnaCijena KM</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.StatusRezervacije</dd>

    <dt class="col-sm-3">Parking mjesto</dt>
    <dd class="col-sm-9">@Model.ParkingMjesto?.Oznaka</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <input type="submit" value="Otkaži rezervaciju" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</form>