@model PametniParkingSistem.Models.Rezervacija

@{
    ViewData["Title"] = "Otkazivanje rezervacije";
}

<div class="cancel-page">

    <div class="cancel-hero">
        <div>
            <span class="cancel-badge">Otkazivanje rezervacije</span>
            <h1>Jeste li sigurni?</h1>
            <p>
                Ova rezervacija će biti označena kao otkazana, a plaćanje će biti evidentirano kao refundirano.
            </p>
        </div>

        <div class="cancel-icon">
            <i class="fa-solid fa-calendar-xmark"></i>
        </div>
    </div>

    <div class="cancel-card">

        <div class="cancel-warning">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>Provjerite podatke prije potvrde otkazivanja.</span>
        </div>

        <div class="cancel-details-grid">

            <div class="cancel-detail-item">
                <span>Vrijeme početka</span>
                <strong>@Model.VrijemePocetka.ToString("dd.MM.yyyy HH:mm")</strong>
            </div>

            <div class="cancel-detail-item">
                <span>Vrijeme kraja</span>
                <strong>@Model.VrijemeKraja.ToString("dd.MM.yyyy HH:mm")</strong>
            </div>

            <div class="cancel-detail-item">
                <span>Registracijske tablice</span>
                <strong>@Model.RegistracijskeTablice</strong>
            </div>

            <div class="cancel-detail-item">
                <span>Kontakt telefon</span>
                <strong>@Model.KontaktTelefon</strong>
            </div>

            <div class="cancel-detail-item">
                <span>Email</span>
                <strong>@Model.EmailZaObavijest</strong>
            </div>

            <div class="cancel-detail-item">
                <span>Ukupna cijena</span>
                <strong>@Model.UkupnaCijena.ToString("0.00") KM</strong>
            </div>

            <div class="cancel-detail-item">
                <span>Status</span>
                <strong>@Model.StatusRezervacije</strong>
            </div>

            <div class="cancel-detail-item">
                <span>Parking mjesto</span>
                <strong>
                    @(Model.ParkingMjesto != null ? Model.ParkingMjesto.Oznaka : $"Mjesto #{Model.ParkingMjestoId}")
                </strong>
            </div>

        </div>

        <form asp-action="Delete" method="post" class="cancel-actions">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger btn-lg">
                <i class="fa-solid fa-ban me-2"></i>
                Otkaži rezervaciju
            </button>

            <a asp-action="Moje" class="btn btn-secondary btn-lg">
                Nazad
            </a>
        </form>

    </div>

</div>