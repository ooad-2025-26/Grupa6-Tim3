@model IEnumerable<PametniParkingSistem.Models.PodrskaZahtjev>
@using PametniParkingSistem.Enums

@{
    ViewData["Title"] = "Podrška";
    string? aktivniStatus = ViewBag.Status as string;
    bool jeAdminIliOperater = User.IsInRole("Administrator") || User.IsInRole("Operater");
}

<div class="page-header mb-4">
    <h1>Podrška</h1>

    @if (jeAdminIliOperater)
    {
        <p class="text-muted">Pregled svih korisničkih zahtjeva za podršku.</p>
    }
    else
    {
        <p class="text-muted">Pregled vaših zahtjeva i odgovora podrške.</p>

        <a asp-action="Create" class="btn btn-success">
            <i class="fa-solid fa-plus me-2"></i>
            Novi zahtjev
        </a>
    }
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-action="Index"
       class="btn @(string.IsNullOrEmpty(aktivniStatus) ? "btn-dark" : "btn-outline-dark")">
        Sve
    </a>

    <a asp-action="Index"
       asp-route-status="Otvoren"
       class="btn @(aktivniStatus == "Otvoren" ? "btn-primary" : "btn-outline-primary")">
        Otvoreni
    </a>

    <a asp-action="Index"
       asp-route-status="UObradi"
       class="btn @(aktivniStatus == "UObradi" ? "btn-warning" : "btn-outline-warning")">
        U obradi
    </a>

    <a asp-action="Index"
       asp-route-status="Rijesen"
       class="btn @(aktivniStatus == "Rijesen" ? "btn-success" : "btn-outline-success")">
        Riješeni
    </a>

    <a asp-action="Index"
       asp-route-status="Zatvoren"
       class="btn @(aktivniStatus == "Zatvoren" ? "btn-secondary" : "btn-outline-secondary")">
        Zatvoreni
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="fa-solid fa-headset"></i>
        <h3>Nema zahtjeva</h3>
        <p>Trenutno nema zahtjeva za podršku.</p>

        @if (!jeAdminIliOperater)
        {
            <a asp-action="Create" class="btn btn-success">
                Pošalji prvi zahtjev
            </a>
        }
    </div>
}
else
{
    <div class="reservation-grid">
        @foreach (var item in Model)
        {
            string statusText = item.Status.ToString();
            string statusClass = "status-neutral";
            string statusIcon = "fa-circle-info";

            if (item.Status == StatusPodrske.Otvoren)
            {
                statusText = "Otvoren";
                statusClass = "status-created";
                statusIcon = "fa-envelope-open";
            }
            else if (item.Status == StatusPodrske.UObradi)
            {
                statusText = "U obradi";
                statusClass = "status-extended";
                statusIcon = "fa-spinner";
            }
            else if (item.Status == StatusPodrske.Rijesen)
            {
                statusText = "Riješen";
                statusClass = "status-active";
                statusIcon = "fa-circle-check";
            }
            else if (item.Status == StatusPodrske.Zatvoren)
            {
                statusText = "Zatvoren";
                statusClass = "status-finished";
                statusIcon = "fa-lock";
            }

            <div class="reservation-card">
                <div class="reservation-card-header">
                    <div>
                        <span class="reservation-label">Zahtjev #@item.Id</span>
                        <h3 style="font-size: 24px;">@item.Naslov</h3>
                    </div>

                    <span class="reservation-status @statusClass">
                        <i class="fa-solid @statusIcon me-1"></i>
                        @statusText
                    </span>
                </div>

                <div class="reservation-details">
                    <div>
                        <span>Kategorija</span>
                        <strong>@item.Kategorija</strong>
                    </div>

                    <div>
                        <span>Prioritet</span>
                        <strong>@item.Prioritet</strong>
                    </div>

                    <div>
                        <span>Datum slanja</span>
                        <strong>@item.DatumKreiranja.ToString("dd.MM.yyyy HH:mm")</strong>
                    </div>

                    <div>
                        <span>Korisnik</span>
                        <strong>
                            @if (item.Korisnik != null)
                            {
                                @($"{item.Korisnik.Ime} {item.Korisnik.Prezime}")
                            }
                            else
                            {
                                @("Nepoznat korisnik")
                            }
                        </strong>
                    </div>
                </div>

                <div class="reservation-created">
                    <i class="fa-regular fa-message me-1"></i>
                    @(item.Odgovor == null ? "Odgovor još nije poslan." : "Podrška je odgovorila.")
                </div>

                <div class="reservation-actions">
                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-outline-secondary btn-sm">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        Detalji
                    </a>

                    @if (jeAdminIliOperater)
                    {
                        <a asp-action="Odgovori"
                           asp-route-id="@item.Id"
                           class="btn btn-success btn-sm">
                            <i class="fa-solid fa-reply me-1"></i>
                            Odgovori
                        </a>
                    }
                </div>
            </div>
        }
    </div>
}