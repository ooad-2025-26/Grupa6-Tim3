@model PametniParkingSistem.Models.PodrskaZahtjev
@using PametniParkingSistem.Enums

@{
    ViewData["Title"] = "Odgovori na zahtjev";
}

<div class="review-create-page">
    <div class="review-create-card">
        <div class="review-create-icon">
            <i class="fa-solid fa-reply"></i>
        </div>

        <h1>Obrada zahtjeva</h1>
        <p class="text-muted">
            Zahtjev #@Model.Id — @Model.Naslov
        </p>

        <div class="review-create-note mb-4">
            <strong>Opis korisnika:</strong><br />
            @Model.Opis
        </div>

        <form asp-controller="Podrska" asp-action="Odgovori" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.Id" />

            <div class="mb-3">
                <label class="form-label">Status zahtjeva</label>
                <select name="status" class="form-select">
                    <option value="UObradi">U obradi</option>
                    <option value="Rijesen">Riješen</option>
                    <option value="Zatvoren">Zatvoren</option>
                </select>
            </div>

            <div class="mb-4">
                <label class="form-label">Odgovor podrške</label>
                <textarea name="odgovor"
                          class="form-control review-textarea"
                          placeholder="Unesite odgovor korisniku...">@Model.Odgovor</textarea>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-success">
                    Sačuvaj odgovor i status
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Nazad
                </a>
            </div>
        </form>
    </div>
</div>