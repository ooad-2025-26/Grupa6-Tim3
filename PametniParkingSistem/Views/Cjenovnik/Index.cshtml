@model IEnumerable<PametniParkingSistem.Models.Cjenovnik>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CijenaPoSatu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VaziOd)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VaziDo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CijenaPoSatu)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VaziOd)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VaziDo)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
